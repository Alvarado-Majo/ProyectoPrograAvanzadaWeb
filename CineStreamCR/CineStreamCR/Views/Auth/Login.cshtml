@model CineStreamCR.BLL.DTO.Auth.LoginDTO

@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>CineStreamCR - Sign In</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css" />
</head>

<body>

    <main class="login-page">

        <section class="login-card">

            <div class="auth-brand">
                CineStream<span>CR</span>
            </div>

            <h1 class="login-title">
                Sign In
            </h1>

            <p class="login-subtitle">
                Welcome back. Continue watching your favorites.
            </p>

            @if (TempData["Success"] != null)
            {
                <div class="auth-success">
                    @TempData["Success"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="auth-error">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Auth"
                  asp-action="Login"
                  method="post">

                <div class="auth-form-group">

                    <label asp-for="Email">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="auth-input"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Email"
                          class="auth-validation">
                    </span>

                </div>

                <div class="auth-form-group">

                    <label asp-for="Password">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="auth-input"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Password"
                          class="auth-validation">
                    </span>

                </div>

                <button type="submit"
                        class="btn-login">
                    Sign In
                </button>

            </form>

            <div class="auth-separator">
                <span>OR</span>
            </div>

            <p class="register-question">
                New to CineStreamCR?
            </p>

            <a asp-controller="Auth"
               asp-action="Register"
               class="btn-create-account">
                Create Account
            </a>

            <div class="auth-footer">
                CineStreamCR
            </div>

        </section>

    </main>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>