@model StreamingApp.Models.ActorDetailViewModel

@{
    ViewData["Title"] = $"{Model.Actor.FirstName} {Model.Actor.LastName}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="actor-detail">

    <!-- INFORMACIÓN DEL ACTOR -->
    <div class="actor-header">

        <div class="actor-photo">

            @if (!string.IsNullOrWhiteSpace(Model.Actor.PictureImg))
            {
                <img src="@Model.Actor.PictureImg"
                     alt="@Model.Actor.FirstName @Model.Actor.LastName" />
            }
            else
            {
                <div class="actor-placeholder">
                    No image
                </div>
            }

        </div>

        <div class="actor-info">

            <h1>
                @Model.Actor.FirstName @Model.Actor.LastName
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.Actor.Nationality))
            {
                <div class="actor-data">
                    <strong>Nationality:</strong>
                    <span>@Model.Actor.Nationality</span>
                </div>
            }

            @if (Model.Actor.BirthDate.HasValue)
            {
                <div class="actor-data">
                    <strong>Date of Birth:</strong>
                    <span>
                        @Model.Actor.BirthDate.Value.ToString("MMMM dd, yyyy")
                    </span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Actor.Biography))
            {
                <div class="biography">

                    <h3>Biography</h3>

                    <p>
                        @Model.Actor.Biography
                    </p>

                </div>
            }

            <a asp-controller="Movie"
                   asp-action="Movies"
                   class="btn-back">
                ← Back to movies
            </a>

        </div>

    </div>


    <!-- PELÍCULAS DEL ACTOR -->
    <div class="actor-movies">

        <h2>Movies</h2>

        @if (Model.Movies != null && Model.Movies.Any())
        {
            <div class="movie-row">

                @foreach (var movie in Model.Movies)
                {
                    <a asp-controller="Movie"
                           asp-action="Details"
                           asp-route-id="@movie.MovieId"
                           class="movie-card">

                        <!--
                            MovieCastMemberDTO no contiene el poster,
                            por eso mostramos un icono.
                        -->
                        <div class="movie-placeholder">
                            🎬
                        </div>

                        <div class="movie-title">
                            @movie.MovieTitle
                        </div>

                        @if (!string.IsNullOrWhiteSpace(movie.CharacterName))
                        {
                            <div class="character-name">
                                as @movie.CharacterName
                            </div>
                        }

                    </a>
                }

            </div>
        }
        else
        {
            <p class="empty-info">
                No movie information available.
            </p>
        }

    </div>

</section>


<style>

    :root {
        --red: #e50914;
        --black: #141414;
        --black-soft: #181818;
        --white: #ffffff;
        --gray: #b3b3b3;
    }

    .actor-detail {
        min-height: 100vh;
        background: var(--black);
        color: var(--white);
        padding: 70px 6%;
    }

    /* ACTOR */

    .actor-header {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        gap: 50px;
        align-items: flex-start;
    }

    .actor-photo img {
        width: 300px;
        height: 420px;
        object-fit: cover;
        border-radius: 10px;
        box-shadow: 0 20px 50px rgba(0,0,0,.7);
    }

    .actor-placeholder {
        width: 300px;
        height: 420px;
        background: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: var(--gray);
    }

    .actor-info {
        flex: 1;
        padding-top: 20px;
    }

        .actor-info h1 {
            font-size: 3rem;
            margin: 0 0 30px;
        }

    .actor-data {
        margin-bottom: 10px;
        color: var(--gray);
    }

        .actor-data strong {
            color: var(--red);
            margin-right: 5px;
        }

    /* BIOGRAFÍA */

    .biography {
        margin-top: 30px;
        max-width: 650px;
    }

        .biography h3 {
            margin-bottom: 10px;
        }

        .biography p {
            color: #ddd;
            line-height: 1.7;
        }

    /* BOTÓN REGRESAR */

    .btn-back {
        display: inline-block;
        margin-top: 25px;
        padding: 10px 20px;
        background: var(--red);
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
    }

        .btn-back:hover {
            opacity: .85;
            color: white;
        }

    /* PELÍCULAS */

    .actor-movies {
        max-width: 1100px;
        margin: 60px auto 0;
        padding-top: 30px;
        border-top: 1px solid #333;
    }

        .actor-movies h2 {
            margin-bottom: 25px;
        }

    .movie-row {
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
    }

    .movie-card {
        width: 170px;
        text-decoration: none;
        color: white;
        transition: transform .2s;
    }

        .movie-card:hover {
            transform: translateY(-5px);
            color: white;
        }

    .movie-placeholder {
        width: 170px;
        height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2b2b2b;
        border-radius: 8px;
        font-size: 3rem;
        border: 1px solid rgba(255,255,255,.1);
    }

    .movie-title {
        margin-top: 10px;
        font-weight: 700;
        font-size: .95rem;
    }

    .character-name {
        color: var(--gray);
        font-size: .82rem;
        margin-top: 3px;
    }

    .empty-info {
        color: var(--gray);
    }

    /* RESPONSIVE */

    @@media (max-width: 768px) {

        .actor-header {
            flex-direction: column;
        }

        .actor-photo img,
        .actor-placeholder {
            width: 220px;
            height: 310px;
        }

        .actor-info h1 {
            font-size: 2.2rem;
        }

        .movie-card {
            width: 135px;
        }

        .movie-placeholder {
            width: 135px;
            height: 200px;
        }
    }

</style>