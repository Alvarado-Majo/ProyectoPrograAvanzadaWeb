@model StreamingApp.Models.MovieDetailViewModel

@{
    var movie = Model.Movie;

    ViewData["Title"] = movie.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="movie-detail">

    @if (TempData["Success"] != null)
    {
        <div class="movie-alert">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="movie-alert">
            @TempData["Error"]
        </div>
    }


    <!-- ════════════════ DETALLE DE PELÍCULA ════════════════ -->

    <div class="movie-hero"
         style="background-image: url('@movie.PosterImg');">

        <div class="movie-overlay">

            <div class="movie-content">

                <img src="@movie.PosterImg"
                     class="movie-poster"
                     alt="@movie.Title" />


                <div class="movie-info">

                    <h1>@movie.Title</h1>


                    <div class="movie-meta">

                        <span>@movie.ReleaseYear</span>

                        <span>@movie.DurationMinutes min</span>

                        @if (movie.MovieRating.HasValue)
                        {
                            <span>
                                ⭐ @movie.MovieRating.Value.ToString("0.0")
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(movie.Nationality))
                        {
                            <span>@movie.Nationality</span>
                        }

                    </div>


                    <!-- BOTONES -->

                    <div class="movie-buttons">

                        @if (!string.IsNullOrWhiteSpace(movie.VideoUrl))
                        {
                            <button type="button"
                                    class="btn-play"
                                    id="btnOpenPlayer">
                                ▶ Play
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn-play"
                                    disabled>
                                ▶ Video unavailable
                            </button>
                        }


                        <form asp-controller="WatchList"
                              asp-action="AddMovie"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="movieId"
                                   value="@movie.MovieId" />

                            <button type="submit"
                                    class="btn-list">
                                + My List
                            </button>

                        </form>

                    </div>


                    <!-- SINOPSIS -->
                    @if (!string.IsNullOrWhiteSpace(movie.Synopsis))
                    {
                        <div class="movie-synopsis">

                            <h3>Synopsis</h3>

                            <p>
                                @movie.Synopsis
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>



    <!-- ════════════════ REPRODUCTOR ════════════════ -->
    @if (!string.IsNullOrWhiteSpace(movie.VideoUrl))
    {
        <section id="playerSection"
                 class="player-section">

            <div class="player-container">


                <div class="player-top">

                    <h2>@movie.Title</h2>

                    <button type="button"
                            id="btnClosePlayer"
                            class="btn-close-player">
                        ✕
                    </button>

                </div>


                <video id="moviePlayer"
                       class="movie-player"
                       poster="@movie.PosterImg"
                       preload="metadata">

                    <source src="@movie.VideoUrl"
                            type="video/mp4" />

                    Your browser does not support video playback.

                </video>


                <!-- BARRA DE PROGRESO -->

                <input type="range"
                       id="progressBar"
                       class="progress-bar"
                       value="0"
                       min="0"
                       step="0.1" />


                <!-- CONTROLES -->

                <div class="player-controls">


                    <!-- PELÍCULA ANTERIOR -->
                    @if (Model.PreviousMovieId.HasValue)
                    {
                        <a asp-controller="Movie"
                               asp-action="Details"
                               asp-route-id="@Model.PreviousMovieId.Value"
                               class="control-btn navigation-btn">

                            ← Previous

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="control-btn"
                                disabled>

                            ← Previous

                        </button>
                    }


                    <!-- RETROCEDER -->

                    <button type="button"
                            id="btnBack"
                            class="control-btn">

                        ↶ 10s

                    </button>


                    <!-- PLAY / PAUSE -->

                    <button type="button"
                            id="btnPlayPause"
                            class="control-btn main-control">

                        ▶ Play

                    </button>


                    <!-- AVANZAR -->

                    <button type="button"
                            id="btnForward"
                            class="control-btn">

                        10s ↷

                    </button>


                    <!-- PELÍCULA SIGUIENTE -->
                    @if (Model.NextMovieId.HasValue)
                    {
                        <a asp-controller="Movie"
                               asp-action="Details"
                               asp-route-id="@Model.NextMovieId.Value"
                               class="control-btn navigation-btn">

                            Next →

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="control-btn"
                                disabled>

                            Next →

                        </button>
                    }


                    <!-- VOLUMEN -->

                    <div class="volume-control">

                        <span>🔊</span>

                        <input type="range"
                               id="volumeBar"
                               min="0"
                               max="1"
                               step="0.1"
                               value="1" />

                    </div>

                </div>

            </div>

        </section>
    }



    <!-- ════════════════ INFORMACIÓN INFERIOR ════════════════ -->

    <section class="movie-bottom">


        <!-- ACTORES -->

        <div class="cast-section">

            <h2>Cast</h2>


            @if (movie.Cast != null &&
                 movie.Cast.Any())
            {
                <div class="cast-row">

                    @foreach (var actor in movie.Cast.Take(4))
                    {
                        <a asp-controller="Actor"
                               asp-action="Details"
                               asp-route-id="@actor.ActorId"
                               class="cast-card">

                            @if (!string.IsNullOrWhiteSpace(actor.ActorPictureImg))
                            {
                                <img src="@actor.ActorPictureImg"
                                     alt="@actor.ActorFullName" />
                            }
                            else
                            {
                                <div class="cast-placeholder">
                                    No image
                                </div>
                            }


                            <div class="cast-name">
                                @actor.ActorFullName
                            </div>


                            @if (!string.IsNullOrWhiteSpace(actor.CharacterName))
                            {
                                <div class="cast-character">
                                    @actor.CharacterName
                                </div>
                            }

                        </a>
                    }

                </div>
            }
            else
            {
                <p class="empty-info">
                    No cast information available.
                </p>
            }

        </div>



        <!-- INFORMACIÓN EXTRA -->

        <div class="movie-extra">


            <!-- GÉNEROS -->
            @if (movie.Categories != null &&
                             movie.Categories.Any())
            {
                <div class="extra-line">

                    <span class="extra-label">
                        Genres:
                    </span>

                    <span>
                        @string.Join(
                            ", ",
                            movie.Categories.Select(x => x.Name)
                        )
                    </span>

                </div>
            }


            <!-- DIRECTORES -->
            @if (movie.Directors != null &&
                             movie.Directors.Any())
            {
                <div class="extra-line">

                    <span class="extra-label">
                        Directors:
                    </span>


                    @foreach (var director in movie.Directors)
                    {
                        <a asp-controller="Director"
                               asp-action="Details"
                               asp-route-id="@director.DirectorId"
                               class="director-link">

                            @director.FullName

                        </a>
                    }

                </div>
            }

        </div>

    </section>

</section>



<style>

    :root {
        --red: #e50914;
        --black: #141414;
        --black-soft: #181818;
        --white: #ffffff;
        --gray: #b3b3b3;
    }


    .movie-detail {
        min-height: 100vh;
        background: var(--black);
        color: var(--white);
    }


    /* ══════════════════════════════════════════
           HERO
           ══════════════════════════════════════════ */

    .movie-hero {
        min-height: calc(100vh - 68px);
        background-size: cover;
        background-position: center;
    }


    .movie-overlay {
        min-height: calc(100vh - 68px);
        background: linear-gradient( 90deg, rgba(20,20,20,.98), rgba(20,20,20,.85), rgba(20,20,20,.40) );
        padding: 70px 5%;
        display: flex;
        align-items: center;
    }


    .movie-content {
        display: flex;
        gap: 35px;
        max-width: 1100px;
    }


    .movie-poster {
        width: 260px;
        border-radius: 10px;
        object-fit: cover;
        box-shadow: 0 20px 50px rgba(0,0,0,.8);
    }


    .movie-info {
        max-width: 580px;
        padding-top: 15px;
    }


        .movie-info h1 {
            font-size: 3.5rem;
            margin-bottom: 15px;
        }


    .movie-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        color: var(--gray);
        font-weight: 600;
    }



    /* ══════════════════════════════════════════
           BOTONES
           ══════════════════════════════════════════ */

    .movie-buttons {
        display: flex;
        gap: 15px;
        margin: 25px 0;
    }


    .btn-play,
    .btn-list {
        border: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
        font-size: 1rem;
    }


    .btn-play {
        background: var(--white);
        color: #000;
    }


    .btn-list {
        background: var(--red);
        color: var(--white);
    }


    .btn-play:disabled {
        opacity: .5;
        cursor: not-allowed;
    }



    /* ══════════════════════════════════════════
           SINOPSIS
           ══════════════════════════════════════════ */

    .movie-synopsis {
        max-width: 520px;
        margin-top: 30px;
        padding-left: 16px;
        border-left: 4px solid var(--red);
    }


        .movie-synopsis p {
            color: #ddd;
            line-height: 1.6;
        }



    /* ══════════════════════════════════════════
           REPRODUCTOR
           ══════════════════════════════════════════ */

    .player-section {
        display: none;
        padding: 30px 5%;
        background: #000;
        border-top: 2px solid var(--red);
        border-bottom: 2px solid var(--red);
    }


        .player-section.active {
            display: block;
        }


    .player-container {
        max-width: 1100px;
        margin: 0 auto;
    }


    .player-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }


        .player-top h2 {
            margin: 0;
        }


    .btn-close-player {
        border: none;
        background: transparent;
        color: var(--white);
        font-size: 1.5rem;
        cursor: pointer;
    }


    .movie-player {
        display: block;
        width: 100%;
        max-height: 600px;
        background: #000;
    }



    /* ══════════════════════════════════════════
           PROGRESO
           ══════════════════════════════════════════ */

    .progress-bar {
        width: 100%;
        margin-top: 15px;
        cursor: pointer;
        accent-color: var(--red);
    }



    /* ══════════════════════════════════════════
           CONTROLES
           ══════════════════════════════════════════ */

    .player-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        margin-top: 15px;
        flex-wrap: wrap;
    }


    .control-btn {
        background: #252525;
        color: var(--white);
        border: 1px solid #555;
        border-radius: 6px;
        padding: 10px 18px;
        cursor: pointer;
        font-weight: 600;
    }


        .control-btn:hover:not(:disabled) {
            background: var(--red);
            color: var(--white);
        }


        .control-btn:disabled {
            opacity: .35;
            cursor: not-allowed;
        }


    .navigation-btn {
        text-decoration: none;
    }


    .main-control {
        min-width: 100px;
    }


    .volume-control {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: 15px;
    }


    #volumeBar {
        cursor: pointer;
        accent-color: var(--red);
    }



    /* ══════════════════════════════════════════
           PARTE INFERIOR
           ══════════════════════════════════════════ */

    .movie-bottom {
        background: var(--black-soft);
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 50px;
        padding: 35px 5%;
    }



    /* ══════════════════════════════════════════
           ACTORES
           ══════════════════════════════════════════ */

    .cast-row {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
    }


    .cast-card {
        width: 125px;
        text-decoration: none;
        color: var(--white);
        transition: transform .2s;
    }


        .cast-card:hover {
            transform: translateY(-5px);
            color: var(--white);
        }


        .cast-card img,
        .cast-placeholder {
            width: 125px;
            height: 155px;
            border-radius: 8px;
            object-fit: cover;
            background: #333;
        }


    .cast-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .75rem;
        color: var(--gray);
    }


    .cast-name {
        margin-top: 8px;
        font-weight: 700;
        font-size: .88rem;
    }


    .cast-character {
        color: var(--gray);
        font-size: .78rem;
    }



    /* ══════════════════════════════════════════
           INFORMACIÓN EXTRA
           ══════════════════════════════════════════ */

    .movie-extra {
        padding-top: 5px;
        font-size: .95rem;
    }


    .extra-line {
        margin-bottom: 14px;
    }


    .extra-label {
        color: var(--red);
        font-weight: 700;
        margin-right: 5px;
    }


    .director-link {
        color: var(--white);
        text-decoration: none;
        margin-right: 8px;
    }


        .director-link:hover {
            color: var(--red);
            text-decoration: underline;
        }


    .empty-info {
        color: var(--gray);
    }



    /* ══════════════════════════════════════════
           RESPONSIVE
           ══════════════════════════════════════════ */

    @@media (max-width: 768px) {

        .movie-content {
            flex-direction: column;
        }

        .movie-poster {
            width: 180px;
        }

        .movie-info h1 {
            font-size: 2.5rem;
        }

        .movie-bottom {
            grid-template-columns: 1fr;
        }

        .player-controls {
            gap: 8px;
        }

        .volume-control {
            margin-left: 0;
        }
    }

</style>



@if (!string.IsNullOrWhiteSpace(movie.VideoUrl))
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                const player =
                    document.getElementById(
                        "moviePlayer"
                    );


                const playerSection =
                    document.getElementById(
                        "playerSection"
                    );


                const btnOpen =
                    document.getElementById(
                        "btnOpenPlayer"
                    );


                const btnClose =
                    document.getElementById(
                        "btnClosePlayer"
                    );


                const btnPlayPause =
                    document.getElementById(
                        "btnPlayPause"
                    );


                const btnBack =
                    document.getElementById(
                        "btnBack"
                    );


                const btnForward =
                    document.getElementById(
                        "btnForward"
                    );


                const progressBar =
                    document.getElementById(
                        "progressBar"
                    );


                const volumeBar =
                    document.getElementById(
                        "volumeBar"
                    );



                /* ── Estado guardado ── */

                const savedUrl =
                    localStorage.getItem(
                        "cineVideoUrl"
                    );


                const savedTime =
                    parseFloat(
                        localStorage.getItem(
                            "cineVideoTime"
                        ) || "0"
                    );


                const savedVolume =
                    parseFloat(
                        localStorage.getItem(
                            "cineVideoVolume"
                        ) || "1"
                    );



                /*
                    Si el video guardado es el mismo
                    que esta película, recuperamos
                    su tiempo y volumen.
                */

                if (
                    savedUrl === "@Html.Raw(movie.VideoUrl)"
                ) {

                    player.volume =
                        savedVolume;


                    volumeBar.value =
                        savedVolume;


                    player.addEventListener(
                        "loadedmetadata",
                        function () {

                            if (
                                savedTime > 0 &&
                                savedTime < player.duration
                            ) {

                                player.currentTime =
                                    savedTime;

                            }

                        });

                }



                /* ══════════════════════════════════
                   ABRIR REPRODUCTOR
                   ══════════════════════════════════ */

                btnOpen.addEventListener(
                    "click",
                    function () {


                        playerSection.classList.add(
                            "active"
                        );


                        playerSection.scrollIntoView({
                            behavior: "smooth"
                        });


                        localStorage.setItem(
                            "cineVideoUrl",
                            "@Html.Raw(movie.VideoUrl)"
                        );


                        localStorage.setItem(
                            "cineVideoTitle",
                            "@Html.Raw(movie.Title.Replace("\"", "\\\""))"
                        );


                        localStorage.setItem(
                            "cineVideoPoster",
                            "@Html.Raw(movie.PosterImg)"
                        );


                        localStorage.setItem(
                            "cineVideoTime",
                            player.currentTime.toString()
                        );


                        localStorage.setItem(
                            "cineVideoVolume",
                            player.volume.toString()
                        );


                        localStorage.setItem(
                            "cineVideoPlaying",
                            "true"
                        );


                        player.play();

                    });



                /* ══════════════════════════════════
                   CERRAR
                   ══════════════════════════════════ */

                btnClose.addEventListener(
                    "click",
                    function () {


                        player.pause();


                        localStorage.setItem(
                            "cineVideoPlaying",
                            "false"
                        );


                        playerSection.classList.remove(
                            "active"
                        );

                    });



                /* ══════════════════════════════════
                   PLAY / PAUSE
                   ══════════════════════════════════ */

                btnPlayPause.addEventListener(
                    "click",
                    function () {

                        if (player.paused) {

                            player.play();

                        }
                        else {

                            player.pause();

                        }

                    });



                player.addEventListener(
                    "play",
                    function () {


                        btnPlayPause.textContent =
                            "⏸ Pause";


                        localStorage.setItem(
                            "cineVideoPlaying",
                            "true"
                        );

                    });



                player.addEventListener(
                    "pause",
                    function () {


                        btnPlayPause.textContent =
                            "▶ Play";


                        localStorage.setItem(
                            "cineVideoPlaying",
                            "false"
                        );

                    });



                /* ══════════════════════════════════
                   RETROCEDER
                   ══════════════════════════════════ */

                btnBack.addEventListener(
                    "click",
                    function () {


                        player.currentTime =
                            Math.max(
                                0,
                                player.currentTime - 10
                            );


                        localStorage.setItem(
                            "cineVideoTime",
                            player.currentTime.toString()
                        );

                    });



                /* ══════════════════════════════════
                   AVANZAR
                   ══════════════════════════════════ */

                btnForward.addEventListener(
                    "click",
                    function () {


                        if (!isNaN(player.duration)) {

                            player.currentTime =
                                Math.min(
                                    player.duration,
                                    player.currentTime + 10
                                );

                        }


                        localStorage.setItem(
                            "cineVideoTime",
                            player.currentTime.toString()
                        );

                    });



                /* ══════════════════════════════════
                   DURACIÓN
                   ══════════════════════════════════ */

                player.addEventListener(
                    "loadedmetadata",
                    function () {

                        progressBar.max =
                            player.duration;

                    });



                /* ══════════════════════════════════
                   PROGRESO
                   ══════════════════════════════════ */

                player.addEventListener(
                    "timeupdate",
                    function () {


                        progressBar.value =
                            player.currentTime;


                        localStorage.setItem(
                            "cineVideoTime",
                            player.currentTime.toString()
                        );

                    });



                /* ══════════════════════════════════
                   CAMBIAR POSICIÓN
                   ══════════════════════════════════ */

                progressBar.addEventListener(
                    "input",
                    function () {


                        player.currentTime =
                            parseFloat(
                                progressBar.value
                            );


                        localStorage.setItem(
                            "cineVideoTime",
                            player.currentTime.toString()
                        );

                    });



                /* ══════════════════════════════════
                   VOLUMEN
                   ══════════════════════════════════ */

                volumeBar.addEventListener(
                    "input",
                    function () {


                        player.volume =
                            parseFloat(
                                volumeBar.value
                            );


                        localStorage.setItem(
                            "cineVideoVolume",
                            player.volume.toString()
                        );

                    });

            });

    </script>
}