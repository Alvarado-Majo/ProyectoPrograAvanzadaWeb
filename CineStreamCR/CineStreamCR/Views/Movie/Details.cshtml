@model StreamingApp.Models.MovieDetailViewModel

@{
    var movie = Model.Movie;

    ViewData["Title"] = movie.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="movie-detail">

    @if (TempData["Success"] != null)
    {
        <div class="movie-alert">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="movie-alert">
            @TempData["Error"]
        </div>
    }


    <!-- ════════════════ DETALLE DE PELÍCULA ════════════════ -->

    <div class="movie-hero"
         style="background-image: url('@movie.PosterImg');">

        <div class="movie-overlay">

            <div class="movie-content">

                <img src="@movie.PosterImg"
                     class="movie-poster"
                     alt="@movie.Title" />


                <div class="movie-info">

                    <h1>@movie.Title</h1>


                    <div class="movie-meta">

                        <span>@movie.ReleaseYear</span>

                        <span>@movie.DurationMinutes min</span>

                        @if (movie.MovieRating.HasValue)
                        {
                            <span>
                                ⭐ @movie.MovieRating.Value.ToString("0.0")
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(movie.Nationality))
                        {
                            <span>@movie.Nationality</span>
                        }

                    </div>


                    <!-- BOTONES -->

                    <div class="movie-buttons">

                        @if (!string.IsNullOrWhiteSpace(movie.VideoUrl))
                        {
                            <button type="button"
                                    class="btn-play"
                                    onclick="playGlobalMovie(
                                '@Html.Raw(movie.VideoUrl)',
                                '@Html.Raw(movie.Title.Replace("'", "\\'"))'
                                )">
                                ▶ Play
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn-play"
                                    disabled>
                                ▶ Video unavailable
                            </button>
                        }


                        <form asp-controller="WatchList"
                              asp-action="AddMovie"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="movieId"
                                   value="@movie.MovieId" />

                            <button type="submit"
                                    class="btn-list">
                                + My List
                            </button>

                        </form>

                    </div>


                    <!-- SINOPSIS -->
                    @if (!string.IsNullOrWhiteSpace(movie.Synopsis))
                    {
                        <div class="movie-synopsis">

                            <h3>Synopsis</h3>

                            <p>
                                @movie.Synopsis
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>





    <!-- ════════════════ INFORMACIÓN INFERIOR ════════════════ -->

    <section class="movie-bottom">


        <!-- ACTORES -->

        <div class="cast-section">

            <h2>Cast</h2>


            @if (movie.Cast != null &&
                 movie.Cast.Any())
            {
                <div class="cast-row">

                    @foreach (var actor in movie.Cast.Take(4))
                    {
                        <a asp-controller="Actor"
                               asp-action="Details"
                               asp-route-id="@actor.ActorId"
                               class="cast-card">

                            @if (!string.IsNullOrWhiteSpace(actor.ActorPictureImg))
                            {
                                <img src="@actor.ActorPictureImg"
                                     alt="@actor.ActorFullName" />
                            }
                            else
                            {
                                <div class="cast-placeholder">
                                    No image
                                </div>
                            }


                            <div class="cast-name">
                                @actor.ActorFullName
                            </div>


                            @if (!string.IsNullOrWhiteSpace(actor.CharacterName))
                            {
                                <div class="cast-character">
                                    @actor.CharacterName
                                </div>
                            }

                        </a>
                    }

                </div>
            }
            else
            {
                <p class="empty-info">
                    No cast information available.
                </p>
            }

        </div>



        <!-- INFORMACIÓN EXTRA -->

        <div class="movie-extra">


            <!-- GÉNEROS -->
            @if (movie.Categories != null &&
                             movie.Categories.Any())
            {
                <div class="extra-line">

                    <span class="extra-label">
                        Genres:
                    </span>

                    <span>
                        @string.Join(
                            ", ",
                            movie.Categories.Select(x => x.Name)
                        )
                    </span>

                </div>
            }


            <!-- DIRECTORES -->
            @if (movie.Directors != null &&
                             movie.Directors.Any())
            {
                <div class="extra-line">

                    <span class="extra-label">
                        Directors:
                    </span>


                    @foreach (var director in movie.Directors)
                    {
                        <a asp-controller="Director"
                               asp-action="Details"
                               asp-route-id="@director.DirectorId"
                               class="director-link">

                            @director.FullName

                        </a>
                    }

                </div>
            }

        </div>

    </section>

</section>

<div id="moviePlayerModal"
     class="movie-player-modal">

    <div class="movie-player-container">

        <button type="button"
                class="movie-player-close"
                onclick="closeMoviePlayer()">
            ✕
        </button>

        <iframe id="moviePlayerIframe"
                src=""
                title="@movie.Title"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen>
        </iframe>

    </div>

</div>
<script>
    function getYouTubeEmbedUrl(url) {

        if (!url)
            return "";

        try {

            // Already an embed URL
            if (url.includes("youtube.com/embed/")) {
                return url;
            }

            // Normal YouTube URL
            if (url.includes("youtube.com/watch")) {

                const parsedUrl = new URL(url);

                const videoId =
                    parsedUrl.searchParams.get("v");

                if (videoId) {
                    return "https://www.youtube.com/embed/"
                        + videoId
                        + "?autoplay=1";
                }
            }

            // Short YouTube URL
            if (url.includes("youtu.be/")) {

                const videoId =
                    url.split("youtu.be/")[1]
                       .split("?")[0];

                return "https://www.youtube.com/embed/"
                    + videoId
                    + "?autoplay=1";
            }

            return url;

        }
        catch {
            return "";
        }
    }


    function openMoviePlayer(button) {

        const videoUrl =
            button.dataset.video;

        const embedUrl =
            getYouTubeEmbedUrl(videoUrl);

        if (!embedUrl) {
            alert("Video unavailable.");
            return;
        }

        const modal =
            document.getElementById("moviePlayerModal");

        const iframe =
            document.getElementById("moviePlayerIframe");

        iframe.src = embedUrl;

        modal.classList.add("show");

        document.body.style.overflow = "hidden";
    }


    function closeMoviePlayer() {

        const modal =
            document.getElementById("moviePlayerModal");

        const iframe =
            document.getElementById("moviePlayerIframe");

        iframe.src = "";

        modal.classList.remove("show");

        document.body.style.overflow = "";
    }


    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {
                closeMoviePlayer();
            }

        }
    );
</script>
<style>

    :root {
        --red: #e50914;
        --black: #141414;
        --black-soft: #181818;
        --white: #ffffff;
        --gray: #b3b3b3;
    }


    .movie-detail {
        min-height: 100vh;
        background: var(--black);
        color: var(--white);
    }


    /* ══════════════════════════════════════════
                   HERO
                   ══════════════════════════════════════════ */

    .movie-hero {
        min-height: calc(100vh - 68px);
        background-size: cover;
        background-position: center;
    }


    .movie-overlay {
        min-height: calc(100vh - 68px);
        background: linear-gradient( 90deg, rgba(20,20,20,.98), rgba(20,20,20,.85), rgba(20,20,20,.40) );
        padding: 70px 5%;
        display: flex;
        align-items: center;
    }


    .movie-content {
        display: flex;
        gap: 35px;
        max-width: 1100px;
    }


    .movie-poster {
        width: 260px;
        border-radius: 10px;
        object-fit: cover;
        box-shadow: 0 20px 50px rgba(0,0,0,.8);
    }


    .movie-info {
        max-width: 580px;
        padding-top: 15px;
    }


        .movie-info h1 {
            font-size: 3.5rem;
            margin-bottom: 15px;
        }


    .movie-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        color: var(--gray);
        font-weight: 600;
    }



    /* ══════════════════════════════════════════
                   BOTONES
                   ══════════════════════════════════════════ */

    .movie-buttons {
        display: flex;
        gap: 15px;
        margin: 25px 0;
    }


    .btn-play,
    .btn-list {
        border: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
        font-size: 1rem;
    }


    .btn-play {
        background: var(--white);
        color: #000;
    }


    .btn-list {
        background: var(--red);
        color: var(--white);
    }


    .btn-play:disabled {
        opacity: .5;
        cursor: not-allowed;
    }



    /* ══════════════════════════════════════════
                   SINOPSIS
                   ══════════════════════════════════════════ */

    .movie-synopsis {
        max-width: 520px;
        margin-top: 30px;
        padding-left: 16px;
        border-left: 4px solid var(--red);
    }


        .movie-synopsis p {
            color: #ddd;
            line-height: 1.6;
        }



    /* ══════════════════════════════════════════
                   REPRODUCTOR
                   ══════════════════════════════════════════ */

    .player-section {
        display: none;
        padding: 30px 5%;
        background: #000;
        border-top: 2px solid var(--red);
        border-bottom: 2px solid var(--red);
    }


        .player-section.active {
            display: block;
        }


    .player-container {
        max-width: 1100px;
        margin: 0 auto;
    }


    .player-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }


        .player-top h2 {
            margin: 0;
        }


    .btn-close-player {
        border: none;
        background: transparent;
        color: var(--white);
        font-size: 1.5rem;
        cursor: pointer;
    }


    .movie-player {
        display: block;
        width: 100%;
        max-height: 600px;
        background: #000;
    }



    /* ══════════════════════════════════════════
                   PROGRESO
                   ══════════════════════════════════════════ */

    .progress-bar {
        width: 100%;
        margin-top: 15px;
        cursor: pointer;
        accent-color: var(--red);
    }



    /* ══════════════════════════════════════════
                   CONTROLES
                   ══════════════════════════════════════════ */

    .player-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        margin-top: 15px;
        flex-wrap: wrap;
    }


    .control-btn {
        background: #252525;
        color: var(--white);
        border: 1px solid #555;
        border-radius: 6px;
        padding: 10px 18px;
        cursor: pointer;
        font-weight: 600;
    }


        .control-btn:hover:not(:disabled) {
            background: var(--red);
            color: var(--white);
        }


        .control-btn:disabled {
            opacity: .35;
            cursor: not-allowed;
        }


    .navigation-btn {
        text-decoration: none;
    }


    .main-control {
        min-width: 100px;
    }


    .volume-control {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: 15px;
    }


    #volumeBar {
        cursor: pointer;
        accent-color: var(--red);
    }



    /* ══════════════════════════════════════════
                   PARTE INFERIOR
                   ══════════════════════════════════════════ */

    .movie-bottom {
        background: var(--black-soft);
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 50px;
        padding: 35px 5%;
    }



    /* ══════════════════════════════════════════
                   ACTORES
                   ══════════════════════════════════════════ */

    .cast-row {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
    }


    .cast-card {
        width: 125px;
        text-decoration: none;
        color: var(--white);
        transition: transform .2s;
    }


        .cast-card:hover {
            transform: translateY(-5px);
            color: var(--white);
        }


        .cast-card img,
        .cast-placeholder {
            width: 125px;
            height: 155px;
            border-radius: 8px;
            object-fit: cover;
            background: #333;
        }


    .cast-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .75rem;
        color: var(--gray);
    }


    .cast-name {
        margin-top: 8px;
        font-weight: 700;
        font-size: .88rem;
    }


    .cast-character {
        color: var(--gray);
        font-size: .78rem;
    }



    /* ══════════════════════════════════════════
                   INFORMACIÓN EXTRA
                   ══════════════════════════════════════════ */

    .movie-extra {
        padding-top: 5px;
        font-size: .95rem;
    }


    .extra-line {
        margin-bottom: 14px;
    }


    .extra-label {
        color: var(--red);
        font-weight: 700;
        margin-right: 5px;
    }


    .director-link {
        color: var(--white);
        text-decoration: none;
        margin-right: 8px;
    }


        .director-link:hover {
            color: var(--red);
            text-decoration: underline;
        }


    .empty-info {
        color: var(--gray);
    }



    /* ══════════════════════════════════════════
                   RESPONSIVE
                   ══════════════════════════════════════════ */

    @@media (max-width: 768px) {

        .movie-content {
            flex-direction: column;
        }

        .movie-poster {
            width: 180px;
        }

        .movie-info h1 {
            font-size: 2.5rem;
        }

        .movie-bottom {
            grid-template-columns: 1fr;
        }

        .player-controls {
            gap: 8px;
        }

        .volume-control {
            margin-left: 0;
        }
    }



    /* ══════════════════════════════════════════
                   MODAL DE VIDEO YOUTUBE
                   ══════════════════════════════════════════ */

    .movie-player-modal {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: none;
        justify-content: center;
        align-items: center;
        padding: 30px;
        background: rgba(0,0,0,.92);
    }

        .movie-player-modal.show {
            display: flex;
        }

    .movie-player-container {
        position: relative;
        width: min(1100px, 95vw);
        aspect-ratio: 16 / 9;
        background: #000;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 25px 80px rgba(0,0,0,.9);
        border: 1px solid rgba(255,255,255,.12);
    }

        .movie-player-container iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }

    .movie-player-close {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 10;
        width: 44px;
        height: 44px;
        border: none;
        border-radius: 50%;
        background: rgba(20,20,20,.9);
        color: #fff;
        font-size: 1.3rem;
        cursor: pointer;
        transition: background .2s, transform .2s;
    }

        .movie-player-close:hover {
            background: var(--red);
            transform: scale(1.08);
        }

</style>
