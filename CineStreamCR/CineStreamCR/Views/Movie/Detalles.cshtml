@{
    ViewData["Title"] = "Detalles";
}

<section class="movie-detail">
    <div class="movie-hero" style="background-image: url('/images/wednesday-backdrop.jpg');">
        <div class="movie-overlay">
            <div class="movie-content">

                <img src="/images/thumb-st.jpg" class="movie-poster" />

                <div class="movie-info">
                    <h1>Wednesday</h1>

                    <div class="movie-meta">
                        <span>2022</span>
                        <span>1h 45min</span>
                        <span>Fantasía</span>
                        <span>⭐ 8.5</span>
                    </div>

                    <p>
                        Wednesday Addams investiga una serie de misterios mientras intenta adaptarse
                        a su nueva vida en Nevermore Academy.
                    </p>

                    <div class="movie-buttons">
                        <button class="btn-play">▶ Reproducir</button>
                        <button class="btn-list">+ Mi Lista</button>
                    </div>

                    <div class="movie-section">
                        <h3>Director</h3>
                        <a asp-controller="Home" asp-action="Director" asp-route-id="1">
                            Tim Burton
                        </a>
                    </div>

                    <div class="movie-section">
                        <h3>Actores principales</h3>

                        <div class="actors">
                            <a asp-controller="Home" asp-action="Actor" asp-route-id="1">
                                Jenna Ortega <span>Wednesday Addams</span>
                            </a>

                            <a asp-controller="Home" asp-action="Actor" asp-route-id="2">
                                Emma Myers <span>Enid Sinclair</span>
                            </a>

                            <a asp-controller="Home" asp-action="Actor" asp-route-id="3">
                                Hunter Doohan <span>Tyler Galpin</span>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .movie-detail {
        background: #141414;
        color: white;
        min-height: 100vh;
    }

    .movie-hero {
        min-height: calc(100vh - 68px);
        background-size: cover;
        background-position: center;
    }

    .movie-overlay {
        min-height: calc(100vh - 68px);
        background: linear-gradient(90deg, #141414 0%, rgba(20,20,20,.85) 45%, rgba(20,20,20,.25) 100%);
        padding: 70px 5%;
        display: flex;
        align-items: center;
    }

    .movie-content {
        display: flex;
        gap: 35px;
        align-items: flex-start;
        max-width: 1100px;
    }

    .movie-poster {
        width: 260px;
        border-radius: 12px;
        box-shadow: 0 20px 50px rgba(0,0,0,.7);
    }

    .movie-info h1 {
        font-size: 4rem;
        font-weight: 900;
        margin-bottom: 15px;
    }

    .movie-meta {
        display: flex;
        gap: 18px;
        color: #ccc;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .movie-info p {
        max-width: 650px;
        color: #ddd;
        font-size: 1.05rem;
        line-height: 1.6;
    }

    .movie-buttons {
        display: flex;
        gap: 15px;
        margin: 25px 0;
    }

    .btn-play,
    .btn-list {
        border: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-play {
        background: #fff;
        color: #000;
    }

    .btn-list {
        background: rgba(109,109,110,.7);
        color: #fff;
    }

    .movie-section {
        margin-top: 25px;
    }

        .movie-section h3 {
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .movie-section a {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }

            .movie-section a:hover {
                color: #e50914;
            }

    .actors {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .actors span {
            color: #aaa;
            margin-left: 8px;
            font-size: .9rem;
        }
</style>