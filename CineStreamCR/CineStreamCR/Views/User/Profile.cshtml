@model CineStreamCR.BLL.DTO.User.UserDTO

@{
    ViewData["Title"] = "My Profile";
}

<style>
    .profile-container {
        max-width: 800px;
        margin: 60px auto;
        padding: 0 25px;
        color: white;
    }

    .profile-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .profile-card {
        background: #181818;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 8px 30px rgba(0,0,0,.35);
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .profile-avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #e50914;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 2rem;
        font-weight: bold;
        color: white;
    }

    .profile-name {
        font-size: 1.6rem;
        font-weight: bold;
    }

    .profile-email {
        color: #aaa;
        margin-top: 5px;
    }

    .profile-info {
        margin-top: 25px;
    }

    .profile-row {
        border-top: 1px solid #333;
        padding: 18px 0;
    }

    .profile-label {
        color: #999;
        font-size: .9rem;
        margin-bottom: 5px;
    }

    .profile-value {
        font-size: 1rem;
        font-weight: 500;
    }

    .profile-actions {
        margin-top: 30px;
    }

    .btn-edit-profile {
        display: inline-block;
        background: #e50914;
        color: white;
        padding: 11px 22px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-edit-profile:hover {
            background: #f6121d;
            color: white;
        }
</style>

<div class="profile-container">

    <h1 class="profile-title">
        My Profile
    </h1>

    <div class="profile-card">

        <div class="profile-header">

            <div class="profile-avatar">
                @Model.FirstName.Substring(0, 1).ToUpper()
            </div>

            <div>
                <div class="profile-name">
                    @Model.FirstName @Model.LastName
                </div>

                <div class="profile-email">
                    @Model.Email
                </div>
            </div>

        </div>

        <div class="profile-info">

            <div class="profile-row">
                <div class="profile-label">
                    First Name
                </div>

                <div class="profile-value">
                    @Model.FirstName
                </div>
            </div>

            <div class="profile-row">
                <div class="profile-label">
                    Last Name
                </div>

                <div class="profile-value">
                    @Model.LastName
                </div>
            </div>

            <div class="profile-row">
                <div class="profile-label">
                    Email
                </div>

                <div class="profile-value">
                    @Model.Email
                </div>
            </div>

            <div class="profile-row">
                <div class="profile-label">
                    Member Since
                </div>

                <div class="profile-value">
                    @Model.SignUpDate.ToString("dd/MM/yyyy")
                </div>
            </div>

        </div>

        <div class="profile-actions">

            <a asp-controller="User"
                   asp-action="EditUser"
                   asp-route-id="@Model.UserId"
                   class="btn-edit-profile">

                Edit Profile

            </a>

        </div>

    </div>

</div>