@{
    ViewData["Title"] = "Admin Menu";
}

<div class="container py-5">
    <section class="mt-4">

        <div class="reports-header mb-5">
            <span class="directory-eyebrow">Panel de administración</span>
            <h2 class="reports-title">Reportes del sistema</h2>
            <p class="reports-intro">Accede y administra cada módulo del sistema desde aquí.</p>
        </div>

        <div class="reports-grid">

            <div class="report-card">
                <div class="report-card-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="report-card-body">
                    <h5 class="report-card-title">Gestión de Actores</h5>
                    <p class="report-card-text">Administra los actores de las películas del sistema</p>
                </div>
                <a asp-action="Actors" asp-controller="Actor" class="btn-report">
                    Ver reporte <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="report-card">
                <div class="report-card-icon">
                    <i class="bi bi-person-heart"></i>
                </div>
                <div class="report-card-body">
                    <h5 class="report-card-title">Gestión de Directores</h5>
                    <p class="report-card-text">Administra los directores de las películas del sistema</p>
                </div>
                <a asp-action="Directors" asp-controller="Director" class="btn-report">
                    Ver reporte <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            
        </div>
    </section>
</div>

    

