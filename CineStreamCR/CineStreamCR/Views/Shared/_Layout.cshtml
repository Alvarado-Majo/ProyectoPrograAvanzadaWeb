<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CineStreamCR</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CineStreamCR.styles.css" asp-append-version="true" />

    <style>

            /* RESET BASE */

            *, *::before, *::after {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #141414;
                color: #fff;
                font-family: 'Inter', 'Segoe UI', sans-serif;
            }


            /* ══════════════════════════════════════════
                                           NAVBAR
                                   ══════════════════════════════════════════ */

            .sf-navbar {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 200;
                height: 68px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 4%;
                background: linear-gradient( 180deg, rgba(0,0,0,.88) 0%, transparent 100% );
                gap: 0;
            }


            /* Logo */

            .sf-navbar__logo {
                position: absolute;
                left: 4%;
                color: #e50914;
                font-size: 1.85rem;
                font-weight: 900;
                letter-spacing: -1px;
                text-decoration: none;
                user-select: none;
            }


            /* Links centrados */

            .sf-navbar__links {
                display: flex;
                align-items: center;
                gap: 6px;
                list-style: none;
                margin: 0;
                padding: 0;
            }

                .sf-navbar__links a {
                    color: #b3b3b3;
                    text-decoration: none;
                    font-size: .875rem;
                    font-weight: 500;
                    padding: 6px 14px;
                    border-radius: 20px;
                    border: 2px solid transparent;
                    transition: color .2s, border-color .2s, background .2s;
                    white-space: nowrap;
                }

                    .sf-navbar__links a:hover {
                        color: #fff;
                    }

                    .sf-navbar__links a.active {
                        color: #fff;
                        border-color: #fff;
                        background: rgba(255,255,255,.08);
                    }


            /* Grupo derecho */

            .sf-navbar__right {
                position: absolute;
                right: 4%;
                display: flex;
                align-items: center;
                gap: 18px;
            }


            /* Búsqueda */

            .sf-navbar__search {
                cursor: pointer;
                color: #fff;
                opacity: .85;
                transition: opacity .2s;
                flex-shrink: 0;
            }

                .sf-navbar__search:hover {
                    opacity: 1;
                }


            /* ══════════════════════════════════════════
                                           PROFILE DROPDOWN
                                   ══════════════════════════════════════════ */

            .sf-profile {
                position: relative;
            }

            .sf-profile__trigger {
                width: 34px;
                height: 34px;
                background: #e50914;
                border-radius: 6px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .75rem;
                font-weight: 700;
                color: #fff;
                user-select: none;
                border: 2px solid transparent;
                transition: border-color .2s;
                flex-shrink: 0;
            }

                .sf-profile__trigger:hover,
                .sf-profile.open .sf-profile__trigger {
                    border-color: #fff;
                }

                .sf-profile__trigger::after {
                    content: '';
                    position: absolute;
                    bottom: -8px;
                    left: 50%;
                    transform: translateX(-50%) rotate(45deg);
                    width: 6px;
                    height: 6px;
                    background: #1a1a1a;
                    border-top: 1.5px solid #555;
                    border-left: 1.5px solid #555;
                    opacity: 0;
                    transition: opacity .18s;
                    border-radius: 1px;
                }

            .sf-profile.open .sf-profile__trigger::after {
                opacity: 1;
            }


            .sf-profile__menu {
                position: absolute;
                top: calc(100% + 14px);
                right: 0;
                min-width: 200px;
                background: #1a1a1a;
                border: 1px solid #333;
                border-radius: 6px;
                overflow: hidden;
                box-shadow: 0 8px 30px rgba(0,0,0,.7);
                opacity: 0;
                pointer-events: none;
                transform: translateY(-6px);
                transition: opacity .2s, transform .2s;
            }

            .sf-profile.open .sf-profile__menu {
                opacity: 1;
                pointer-events: all;
                transform: translateY(0);
            }


            .sf-profile__menu::before {
                content: '';
                position: absolute;
                top: -6px;
                right: 12px;
                width: 11px;
                height: 11px;
                background: #1a1a1a;
                border-top: 1px solid #333;
                border-left: 1px solid #333;
                transform: rotate(45deg);
            }


            .sf-profile__item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 16px;
                font-size: .85rem;
                color: #ccc;
                text-decoration: none;
                cursor: pointer;
                transition: background .15s, color .15s;
                border: none;
                background: transparent;
                width: 100%;
                text-align: left;
            }

                .sf-profile__item:hover {
                    background: #2a2a2a;
                    color: #fff;
                }

                .sf-profile__item svg {
                    flex-shrink: 0;
                    opacity: .7;
                }

                .sf-profile__item:hover svg {
                    opacity: 1;
                }


            .sf-profile__divider {
                height: 1px;
                background: #333;
                margin: 4px 0;
            }


            .sf-profile__item--danger {
                color: #e50914;
            }

                .sf-profile__item--danger:hover {
                    background: rgba(229,9,20,.1);
                    color: #ff3333;
                }


            /* ══════════════════════════════════════════
                                           MAIN CONTENT
                                   ══════════════════════════════════════════ */

            .sf-main {
                padding-top: 68px;
            }


            /* ══════════════════════════════════════════
                                           MINI PLAYER
                                   ══════════════════════════════════════════ */

            .sf-mini-player {
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 300;
                min-height: 82px;
                display: none;
                align-items: center;
                gap: 15px;
                padding: 8px 4%;
                background: #181818;
                border-top: 2px solid #e50914;
                box-shadow: 0 -5px 20px rgba(0,0,0,.7);
            }

                .sf-mini-player.active {
                    display: flex;
                }


            .sf-mini-player__poster {
                width: 48px;
                height: 65px;
                object-fit: cover;
                border-radius: 5px;
                background: #292929;
                flex-shrink: 0;
            }


            .sf-mini-player__info {
                flex: 1;
                min-width: 120px;
            }


            .sf-mini-player__title {
                color: #fff;
                font-size: .9rem;
                font-weight: 700;
                margin-bottom: 8px;
            }


            .sf-mini-player__progress {
                width: 100%;
                cursor: pointer;
                accent-color: #e50914;
            }


            .sf-mini-player__controls {
                display: flex;
                align-items: center;
                gap: 8px;
            }


            .sf-mini-player__button {
                border: none;
                background: #292929;
                color: #fff;
                padding: 7px 10px;
                border-radius: 5px;
                cursor: pointer;
                font-size: .85rem;
                transition: background .2s, transform .15s;
            }

                .sf-mini-player__button:hover {
                    background: #e50914;
                    transform: scale(1.03);
                }


            .sf-mini-player__volume {
                width: 85px;
                cursor: pointer;
                accent-color: #e50914;
            }


            body.sf-mini-player-visible {
                padding-bottom: 82px;
            }


            /* ══════════════════════════════════════════
                                           FOOTER
                                   ══════════════════════════════════════════ */

            .sf-footer {
                padding: 28px 4%;
                color: #6d6d6d;
                font-size: .78rem;
                border-top: 1px solid #222;
                margin-top: 40px;
            }

                .sf-footer a {
                    color: #6d6d6d;
                    text-decoration: none;
                }

                    .sf-footer a:hover {
                        color: #aaa;
                    }


            /* ══════════════════════════════════════════
                                           RESPONSIVE
                                   ══════════════════════════════════════════ */

            @@media (max-width: 768px) {

                .sf-navbar__links {
                    gap: 2px;
                }

                    .sf-navbar__links a {
                        padding: 5px 8px;
                        font-size: .75rem;
                    }

                .sf-navbar__search {
                    display: none;
                }

                .sf-mini-player {
                    min-height: 100px;
                    flex-wrap: wrap;
                    padding: 8px 12px;
                }

                .sf-mini-player__info {
                    flex: 1;
                }

                .sf-mini-player__controls {
                    width: 100%;
                    justify-content: center;
                }

                .sf-mini-player__volume {
                    width: 65px;
                }

                body.sf-mini-player-visible {
                    padding-bottom: 120px;
                }
            }

    </style>
</head>


<body>

