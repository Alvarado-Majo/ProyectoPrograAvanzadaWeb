    <!-- ════════════════ SCRIPTS ════════════════ -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>



    <!-- DROPDOWN DE PERFIL -->

    <script>

            (function () {

                const profile =
                    document.getElementById('sfProfile');

                const trigger =
                    document.getElementById('sfProfileTrigger');

                const menu =
                    document.getElementById('sfProfileMenu');


                if (!profile ||
                    !trigger ||
                    !menu) {

                    return;
                }


                trigger.addEventListener(
                    'click',
                    function (e) {

                        e.stopPropagation();

                        profile.classList.toggle(
                            'open'
                        );

                    });


                document.addEventListener(
                    'click',
                    function () {

                        profile.classList.remove(
                            'open'
                        );

                    });


                menu.addEventListener(
                    'click',
                    function (e) {

                        e.stopPropagation();

                    });

            })();

    </script>



    <!-- MINI REPRODUCTOR PERSISTENTE -->

    <script>

            document.addEventListener(
                "DOMContentLoaded",
                function () {


                    const miniPlayer =
                        document.getElementById(
                            "sfMiniPlayer"
                        );


                    const miniPoster =
                        document.getElementById(
                            "sfMiniPlayerPoster"
                        );


                    const miniTitle =
                        document.getElementById(
                            "sfMiniPlayerTitle"
                        );


                    const miniProgress =
                        document.getElementById(
                            "sfMiniProgress"
                        );


                    const miniPlayPause =
                        document.getElementById(
                            "sfMiniPlayPause"
                        );


                    const miniBack =
                        document.getElementById(
                            "sfMiniBack"
                        );


                    const miniForward =
                        document.getElementById(
                            "sfMiniForward"
                        );


                    const miniVolume =
                        document.getElementById(
                            "sfMiniVolume"
                        );


                    const miniClose =
                        document.getElementById(
                            "sfMiniClose"
                        );



                    // Datos guardados del reproductor

                    const savedUrl =
                        localStorage.getItem(
                            "cineVideoUrl"
                        );


                    if (!savedUrl) {
                        return;
                    }


                    const savedTitle =
                        localStorage.getItem(
                            "cineVideoTitle"
                        ) || "Movie";


                    const savedPoster =
                        localStorage.getItem(
                            "cineVideoPoster"
                        ) || "";


                    const savedTime =
                        parseFloat(
                            localStorage.getItem(
                                "cineVideoTime"
                            ) || "0"
                        );


                    const savedVolume =
                        parseFloat(
                            localStorage.getItem(
                                "cineVideoVolume"
                            ) || "1"
                        );


                    const savedPlaying =
                        localStorage.getItem(
                            "cineVideoPlaying"
                        ) === "true";



                    // Crear elemento de reproducción

                    const player =
                        document.createElement(
                            "video"
                        );


                    player.src =
                        savedUrl;


                    player.preload =
                        "metadata";


                    player.style.display =
                        "none";


                    document.body.appendChild(
                        player
                    );



                    // Mostrar mini player

                    miniPlayer.classList.add(
                        "active"
                    );


                    document.body.classList.add(
                        "sf-mini-player-visible"
                    );


                    miniTitle.textContent =
                        savedTitle;


                    miniPoster.src =
                        savedPoster;


                    player.volume =
                        savedVolume;


                    miniVolume.value =
                        savedVolume;



                    // Cargar información del video

                    player.addEventListener(
                        "loadedmetadata",
                        function () {


                            miniProgress.max =
                                player.duration;


                            if (
                                savedTime > 0 &&
                                savedTime < player.duration
                            ) {

                                player.currentTime =
                                    savedTime;

                            }


                            if (savedPlaying) {

                                player.play()
                                    .catch(
                                        function () {

                                            // Algunos navegadores
                                            // bloquean autoplay

                                        }
                                    );

                            }

                        });



                    // Play

                    player.addEventListener(
                        "play",
                        function () {

                            miniPlayPause.textContent =
                                "⏸";


                            localStorage.setItem(
                                "cineVideoPlaying",
                                "true"
                            );

                        });



                    // Pause

                    player.addEventListener(
                        "pause",
                        function () {

                            miniPlayPause.textContent =
                                "▶";


                            localStorage.setItem(
                                "cineVideoPlaying",
                                "false"
                            );

                        });



                    // Progreso

                    player.addEventListener(
                        "timeupdate",
                        function () {

                            miniProgress.value =
                                player.currentTime;


                            localStorage.setItem(
                                "cineVideoTime",
                                player.currentTime.toString()
                            );

                        });



                    // Play / Pause

                    miniPlayPause.addEventListener(
                        "click",
                        function () {

                            if (player.paused) {

                                player.play();

                            }
                            else {

                                player.pause();

                            }

                        });



                    // Retroceder

                    miniBack.addEventListener(
                        "click",
                        function () {

                            player.currentTime =
                                Math.max(
                                    0,
                                    player.currentTime - 10
                                );

                        });



                    // Avanzar

                    miniForward.addEventListener(
                        "click",
                        function () {

                            if (!isNaN(player.duration)) {

                                player.currentTime =
                                    Math.min(
                                        player.duration,
                                        player.currentTime + 10
                                    );

                            }

                        });



                    // Mover progreso

                    miniProgress.addEventListener(
                        "input",
                        function () {

                            player.currentTime =
                                parseFloat(
                                    miniProgress.value
                                );

                        });



                    // Volumen

                    miniVolume.addEventListener(
                        "input",
                        function () {

                            player.volume =
                                parseFloat(
                                    miniVolume.value
                                );


                            localStorage.setItem(
                                "cineVideoVolume",
                                player.volume.toString()
                            );

                        });



                    // Cerrar reproductor

                    miniClose.addEventListener(
                        "click",
                        function () {

                            player.pause();

                            player.remove();


                            miniPlayer.classList.remove(
                                "active"
                            );


                            document.body.classList.remove(
                                "sf-mini-player-visible"
                            );


                            localStorage.removeItem(
                                "cineVideoUrl"
                            );


                            localStorage.removeItem(
                                "cineVideoTitle"
                            );


                            localStorage.removeItem(
                                "cineVideoPoster"
                            );


                            localStorage.removeItem(
                                "cineVideoTime"
                            );


                            localStorage.removeItem(
                                "cineVideoVolume"
                            );


                            localStorage.removeItem(
                                "cineVideoPlaying"
                            );

                        });

                });

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )
    <!-- GLOBAL MOVIE PLAYER -->
    <div id="globalMoviePlayer"
         class="global-player">

        <div class="global-player-header">

            <span id="globalPlayerTitle">
                Now Playing
            </span>

            <div class="global-player-actions">

                <button type="button"
                        id="expandPlayer"
                        title="Expand">
                    ⛶
                </button>

                <button type="button"
                        id="closeGlobalPlayer"
                        title="Close">
                    ✕
                </button>

            </div>

        </div>

        <div id="youtubeGlobalPlayer"></div>

    </div>

    <script src="https://www.youtube.com/iframe_api"></script>

    <script>
        let globalYoutubePlayer = null;
        let globalSaveTimer = null;

        function getYouTubeVideoId(url) {

        if (!url)
        return null;

        try {

        if (url.includes("youtu.be/")) {
        return url
        .split("youtu.be/")[1]
        .split("?")[0];
        }

        if (url.includes("youtube.com/watch")) {
        const parsedUrl = new URL(url);
        return parsedUrl.searchParams.get("v");
        }

        if (url.includes("youtube.com/embed/")) {
        return url
        .split("youtube.com/embed/")[1]
        .split("?")[0];
        }

        return null;
        }
        catch {
        return null;
        }
        }


        function onYouTubeIframeAPIReady() {

        const savedVideoId =
        localStorage.getItem("cineGlobalVideoId");

        if (!savedVideoId)
        return;

        createGlobalPlayer(savedVideoId);
        }


        function createGlobalPlayer(videoId) {

        const playerBox =
        document.getElementById("globalMoviePlayer");

        const title =
        localStorage.getItem("cineGlobalTitle")
        ?? "Now Playing";

        const savedTime =
        parseFloat(
        localStorage.getItem("cineGlobalTime")
        ?? "0"
        );

        const shouldPlay =
        localStorage.getItem("cineGlobalPlaying")
        === "true";

        document.getElementById(
        "globalPlayerTitle"
        ).textContent = title;

        playerBox.classList.add("active");


        if (globalYoutubePlayer) {

        globalYoutubePlayer.loadVideoById({
        videoId: videoId,
        startSeconds: savedTime
        });

        return;
        }


        globalYoutubePlayer =
        new YT.Player(
        "youtubeGlobalPlayer",
        {
        videoId: videoId,

        playerVars: {
        autoplay: shouldPlay ? 1 : 0,
        controls: 1,
        rel: 0,
        start: Math.floor(savedTime)
        },

        events: {

        onReady: function (event) {

        if (savedTime > 0) {
        event.target.seekTo(
        savedTime,
        true
        );
        }

        if (shouldPlay) {
        event.target.playVideo();
        }

        startSavingGlobalTime();
        },

        onStateChange: function (event) {

        if (
        event.data ===
        YT.PlayerState.PLAYING
        ) {
        localStorage.setItem(
        "cineGlobalPlaying",
        "true"
        );
        }

        if (
        event.data ===
        YT.PlayerState.PAUSED
        ) {
        localStorage.setItem(
        "cineGlobalPlaying",
        "false"
        );

        saveGlobalPlayerTime();
        }

        if (
        event.data ===
        YT.PlayerState.ENDED
        ) {
        localStorage.setItem(
        "cineGlobalPlaying",
        "false"
        );

        localStorage.setItem(
        "cineGlobalTime",
        "0"
        );
        }
        }
        }
        }
        );
        }


        window.playGlobalMovie =
        function (videoUrl, movieTitle) {

        const videoId =
        getYouTubeVideoId(videoUrl);

        if (!videoId) {
        alert("Video unavailable.");
        return;
        }

        localStorage.setItem(
        "cineGlobalVideoId",
        videoId
        );

        localStorage.setItem(
        "cineGlobalTitle",
        movieTitle
        );

        localStorage.setItem(
        "cineGlobalTime",
        "0"
        );

        localStorage.setItem(
        "cineGlobalPlaying",
        "true"
        );

        document.getElementById(
        "globalPlayerTitle"
        ).textContent = movieTitle;

        document.getElementById(
        "globalMoviePlayer"
        ).classList.add("active");


        if (globalYoutubePlayer) {

        globalYoutubePlayer.loadVideoById(
        videoId
        );

        globalYoutubePlayer.playVideo();
        }
        else {

        createGlobalPlayer(videoId);
        }
        };


        function saveGlobalPlayerTime() {

        if (
        !globalYoutubePlayer ||
        typeof globalYoutubePlayer.getCurrentTime
        !== "function"
        ) {
        return;
        }

        const currentTime =
        globalYoutubePlayer.getCurrentTime();

        if (!isNaN(currentTime)) {

        localStorage.setItem(
        "cineGlobalTime",
        currentTime.toString()
        );
        }
        }


        function startSavingGlobalTime() {

        if (globalSaveTimer)
        clearInterval(globalSaveTimer);

        globalSaveTimer =
        setInterval(
        saveGlobalPlayerTime,
        1000
        );
        }


        document.addEventListener(
        "DOMContentLoaded",
        function () {

        const closeButton =
        document.getElementById(
        "closeGlobalPlayer"
        );

        const expandButton =
        document.getElementById(
        "expandPlayer"
        );

        const playerBox =
        document.getElementById(
        "globalMoviePlayer"
        );


        closeButton?.addEventListener(
        "click",
        function () {

        if (globalYoutubePlayer) {
        globalYoutubePlayer.stopVideo();
        }

        localStorage.removeItem(
        "cineGlobalVideoId"
        );

        localStorage.removeItem(
        "cineGlobalTitle"
        );

        localStorage.removeItem(
        "cineGlobalTime"
        );

        localStorage.removeItem(
        "cineGlobalPlaying"
        );

        playerBox.classList.remove(
        "active",
        "expanded"
        );
        }
        );


        expandButton?.addEventListener(
        "click",
        function () {

        playerBox.classList.toggle(
        "expanded"
        );
        }
        );
        }
        );


        window.addEventListener(
        "pagehide",
        function () {
        saveGlobalPlayerTime();
        }
        );
    </script>

</body>
</html>